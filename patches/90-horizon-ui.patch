+ *--------------------------------------------------------------------------------------------*/
+
+import { localize } from '../../../../nls.js';
+import { Registry } from '../../../../platform/registry/common/platform.js';
+import { IViewDescriptorService, setViewContainerLauncher, ViewContainerLocation } from '../../../common/views.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { IPaneCompositePartService } from '../../../services/panecomposite/browser/panecomposite.js';
+import { IWorkbenchLayoutService, Parts } from '../../../services/layout/browser/layoutService.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { IConfigurationRegistry, Extensions as ConfigurationExtensions, ConfigurationScope } from '../../../../platform/configuration/common/configurationRegistry.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';
+import { INotificationService } from '../../../../platform/notification/common/notification.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { Disposable, MutableDisposable } from '../../../../base/common/lifecycle.js';
+import { onUnexpectedError } from '../../../../base/common/errors.js';
+import { runAtThisOrScheduleAtNextAnimationFrame } from '../../../../base/browser/dom.js';
+import { mainWindow } from '../../../../base/browser/window.js';
+import { VIEWLET_ID as SCM_VIEWLET_ID } from '../../scm/common/scm.js';
+import { IEditorGroupsService } from '../../../services/editor/common/editorGroupsService.js';
+import { IHorizonScreenService } from './horizonScreens.js';
+
+const EXPLORER_CONTAINER_ID = 'workbench.view.explorer';
+const SCM_OPEN_COMMAND_SETTING = 'horizon.scm.openCommand';
+const UNPIN_BY_DEFAULT = ['workbench.view.debug', 'workbench.view.extension.test', 'workbench.view.remote'];
+const LAUNCHER_FRAME_PRIORITY = 10000; // before other frame work (editor rendering uses 100), so it sees the restored side bar
+
+Registry.as<IConfigurationRegistry>(ConfigurationExtensions.Configuration).registerConfiguration({
+	id: 'horizon',
+	order: 100,
+	title: localize('horizonConfigurationTitle', "Horizon"),
+	type: 'object',
+	properties: {
+		[SCM_OPEN_COMMAND_SETTING]: {
+			type: 'string',
+			default: '',
+			scope: ConfigurationScope.WINDOW,
+			restricted: true,
+			description: localize('horizon.scm.openCommand', "When set, opening the Source Control view runs this command instead, and the built-in Source Control views are hidden. The value is a command ID; it is ignored in untrusted workspaces. Built-in extensions may provide a default.")
+		}
+	}
+});
+
+class HorizonLauncherContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.horizonLaunchers';
+
+	private lastSidebarId: string;
+	private redirecting = false; // a launcher command is running
+	private openingTarget = false; // the side bar is being restored after a launcher container was opened
+	private pendingRedirect: { readonly id: string; readonly command: string } | undefined; // the latest launcher run meanwhile
+	private sidebarJustShown = false; // the side bar became visible in the current task
+	private sidebarHiddenBeforeLauncher = false; // the side bar was hidden before the pending launcher container opened it
+	private readonly launcherFrame = this._register(new MutableDisposable());
+
+	constructor(
+		@IViewDescriptorService private readonly viewDescriptorService: IViewDescriptorService,
+		@IPaneCompositePartService private readonly paneCompositeService: IPaneCompositePartService,
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+		@ICommandService private readonly commandService: ICommandService,
+		@IConfigurationService private readonly configurationService: IConfigurationService,
+		@INotificationService private readonly notificationService: INotificationService,
+		@ILogService private readonly logService: ILogService,
+		@IHorizonScreenService private readonly screenService: IHorizonScreenService,
+		@IEditorGroupsService private readonly editorGroupService: IEditorGroupsService,
+	) {
+		super();
+
+		const activeId = this.paneCompositeService.getActivePaneComposite(ViewContainerLocation.Sidebar)?.getId();
+		this.lastSidebarId = activeId && !this.getCommand(activeId) ? activeId : EXPLORER_CONTAINER_ID;
+
+		// Activity bar entries of launchers run the launcher without opening the container (see ViewContainerActivityAction.run).
+		this._register(setViewContainerLauncher({ launch: id => this.launch(id) }));
+
+		this._register(this.layoutService.onDidChangePartVisibility(e => {
+			if (e.partId === Parts.SIDEBAR_PART && e.visible) {
+				this.sidebarJustShown = true;
+				queueMicrotask(() => this.sidebarJustShown = false);
+			}
+		}));
+
+		this._register(this.paneCompositeService.onDidPaneCompositeOpen(e => {
+			if (e.viewContainerLocation !== ViewContainerLocation.Sidebar) {
+				return;
+			}
+
+			const id = e.composite.getId();
+			const command = this.getCommand(id);
+			if (command) {
+				this.onLauncherOpened(id, command);
+			} else {
+				this.lastSidebarId = id;
+				if (!this.openingTarget && !this.screenService.isChangingLayout) {
+					this.launcherFrame.clear(); // the user navigated: a launcher that has not run yet no longer applies
+					this.pendingRedirect = undefined; // nor does a queued one
+					this.closeScreenForSidebar(); // the user opened a regular side bar view
+				}
+			}
+		}));
+
+		if (activeId && this.layoutService.isVisible(Parts.SIDEBAR_PART)) {
+			const command = this.getCommand(activeId);
+			if (command) {
+				this.onLauncherOpened(activeId, command);
+			}
+		}
+	}
+
+	private getCommand(id: string): string | undefined {
+		if (id === SCM_VIEWLET_ID) {
+			const value = this.configurationService.getValue<unknown>(SCM_OPEN_COMMAND_SETTING);
+			return typeof value === 'string' && value.length > 0 ? value : undefined;
+		}
+
+		return this.viewDescriptorService.getViewContainerById(id)?.openCommand;
+	}
+
+	private closeScreenForSidebar(): void {
+		if (this.screenService.activeScreen === undefined) {
+			return;
+		}
+
+		// A screen and the side bar are never shown together: close the screen so the editors return.
+		this.screenService.hide();
+
+		// Focus was in the (now hidden) screen unless a part kept it; only then move it to the editors, and only if they are shown.
+		const focusKept = this.layoutService.hasFocus(Parts.SIDEBAR_PART) || this.layoutService.hasFocus(Parts.PANEL_PART) || this.layoutService.hasFocus(Parts.AUXILIARYBAR_PART);
+		if (!focusKept && this.layoutService.isVisible(Parts.EDITOR_PART, mainWindow)) {
+			this.editorGroupService.mainPart.activeGroup.focus();
+		}
+	}
+
+	/** The activity bar entry of a launcher was clicked: run its command. The side bar stays as it is. */
+	private launch(id: string): boolean {
+		const container = this.viewDescriptorService.getViewContainerById(id);
+		if (!container || this.viewDescriptorService.getViewContainerLocation(container) !== ViewContainerLocation.Sidebar) {
+			return false;
+		}
+		const command = this.getCommand(id);
+		if (!command) {
+			return false;
+		}
+		void this.runLauncher(id, command);
+		return true;
+	}
+
+	/** A launcher container was opened in the side bar in another way: restore the side bar before the next frame is painted, then run the command. */
+	private onLauncherOpened(id: string, command: string): void {
+		if (!this.launcherFrame.value) {
+			this.sidebarHiddenBeforeLauncher = this.sidebarJustShown;
+		}
+		this.launcherFrame.value = runAtThisOrScheduleAtNextAnimationFrame(mainWindow, () => {
+			this.launcherFrame.clearAndLeak();
+			const sidebarWasHidden = this.sidebarHiddenBeforeLauncher;
+			this.sidebarHiddenBeforeLauncher = false;
+			this.restoreSidebar(id, sidebarWasHidden).then(() => this.runLauncher(id, command)).catch(onUnexpectedError);
+		}, LAUNCHER_FRAME_PRIORITY);
+	}
+
+	/**
+	 * Puts the side bar back the way it was before the launcher container opened. The layout changes happen synchronously
+	 * (a registered container opens synchronously), so nothing in between is painted.
+	 */
+	private restoreSidebar(id: string, sidebarWasHidden: boolean): Promise<unknown> {
+		if (this.paneCompositeService.getActivePaneComposite(ViewContainerLocation.Sidebar)?.getId() !== id) {
+			return Promise.resolve(); // the launcher container is no longer shown
+		}
+		const target = this.getCommand(this.lastSidebarId) ? EXPLORER_CONTAINER_ID : this.lastSidebarId; // never re-open a launcher
+		this.openingTarget = true;
+		const opened = this.paneCompositeService.openPaneComposite(target, ViewContainerLocation.Sidebar, false);
+		if (sidebarWasHidden) {
+			this.layoutService.setPartHidden(true, Parts.SIDEBAR_PART);
+		}
+		return opened.finally(() => this.openingTarget = false);
+	}
+
+	private async runLauncher(id: string, command: string): Promise<void> {
+		if (this.redirecting) {
+			this.pendingRedirect = { id, command }; // never two launcher commands at once: run the latest one afterwards
+			return;
+		}
+
+		this.redirecting = true;
+		try {
+			await this.commandService.executeCommand(command);
+		} catch (err) {
+			const title = this.viewDescriptorService.getViewContainerById(id)?.title.value ?? id;
+			this.logService.error(err);
+			this.notificationService.error(localize('horizon.launcherFailed', "Could not open {0}: {1}", title, String(err)));
+		} finally {
+			this.redirecting = false;
+		}
+
+		const next = this.pendingRedirect;
+		this.pendingRedirect = undefined;
+		if (next && !this._store.isDisposed) {
+			await this.runLauncher(next.id, next.command);
+		}
+	}
+}
+
+class HorizonActivityBarDefaultsContribution implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.horizonActivityBarDefaults';
+
+	private static readonly PINNED_KEY = 'workbench.activity.pinnedViewlets2';
+	private static readonly MARKER_KEY = 'horizon.activityBar.defaultsApplied';
+
+	constructor(
+		@IStorageService storageService: IStorageService,
+	) {
+		if (storageService.getBoolean(HorizonActivityBarDefaultsContribution.MARKER_KEY, StorageScope.PROFILE, false)) {
+			return;
+		}
+
+		let entries: { id: string; pinned: boolean; visible: boolean; order?: number }[];
+		try {
+			const parsed = JSON.parse(storageService.get(HorizonActivityBarDefaultsContribution.PINNED_KEY, StorageScope.PROFILE, '[]'));
+			entries = Array.isArray(parsed) ? parsed : [];
+		} catch {
+			entries = [];
+		}
+
+		for (const id of UNPIN_BY_DEFAULT) {
+			const existing = entries.find(entry => entry.id === id);
+			if (existing) {
+				existing.pinned = false;
+			} else {
+				entries.push({ id, pinned: false, visible: true });
+			}
+		}
+
+		storageService.store(HorizonActivityBarDefaultsContribution.PINNED_KEY, JSON.stringify(entries), StorageScope.PROFILE, StorageTarget.USER);
+		storageService.store(HorizonActivityBarDefaultsContribution.MARKER_KEY, true, StorageScope.PROFILE, StorageTarget.MACHINE);
+	}
+}
+
+registerWorkbenchContribution2(HorizonLauncherContribution.ID, HorizonLauncherContribution, WorkbenchPhase.AfterRestored);
+registerWorkbenchContribution2(HorizonActivityBarDefaultsContribution.ID, HorizonActivityBarDefaultsContribution, WorkbenchPhase.BlockStartup);
